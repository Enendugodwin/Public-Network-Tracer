{
  "manifest_version": 3,
  "name": "Browser Response Monitor",
  "version": "1.0.0",
  "description": "Monitor HTTP responses generated by your browser.",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Response Monitor",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
