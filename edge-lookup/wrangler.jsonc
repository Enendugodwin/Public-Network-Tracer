{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "public-network-tracer",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "EXTRA_PORTS": "",
    "ALLOWED_ORIGIN": "https://enendugodwin.github.io"
  }
}
